# Copy to .env and fill in. Never commit real values.

# Where the sqlite file lives. Mount a volume at this path to persist.
STORAGE_PATH=./data

# Capability routes require this bearer token (HTTP 401 without it).
PLATFORM_TOKEN=dev-local-token
# Extra principals: "token:tenant,token:tenant". A second brokerage is a row.
# TENANT_TOKENS=token-b:tenant-b
# TENANT_NAMES=tenant-b:Second brokerage

# --- Money: the brief named no country and no currency, so none is assumed ---
# Both are REQUIRED before any price or commission is computed; the platform
# refuses by name until they are set.
# CURRENCY=AED
# BROKER_COMMISSION_PERCENT=2
# Optional: tax/VAT on a quoted price.
# TAX_RATE_PERCENT=

# --- Dial pacing: the brokerage's own caps (defaults stated, not assumed) ---
# DAILY_CALL_CAP=200
# CONCURRENCY=3
# LOCAL_DRIVE_ROOT=./data

# --- Twilio Programmable Voice: STUBBED until all three are set ---
# With any of them unset the gateway dials the recorded fake-Twilio fixtures in
# tests/fixtures/twilio/ and refuses to open a socket. CI never dials.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_CALLER_NUMBER=

# --- Warm transfer: the human broker's line (no default) ---
# Without it (and without a broker_number on the record) the transfer is
# recorded as declined and the setting is named in the response's blocker.
# BROKER_TRANSFER_NUMBER=

# --- Notification mail channel (optional; falls back to in-process MCP) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# NOTIFY_FROM=

# --- Google Drive (optional; drive_mode stays 'stubbed' without it) ---
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# or GOOGLE_ACCESS_TOKEN=

# Deploy identity for /health and scripts/rollback.sh (optional).
# APP_REVISION=rev-n
# APP_MARK=baseline

# P1: offline strict. Local/scripted OCR only. No LLM provider. No Ollama.
# No store URL. No store key. Vendored blocks, in-process dispatch.
# tests/conftest.py refuses non-loopback sockets. That blocker is unchanged.
