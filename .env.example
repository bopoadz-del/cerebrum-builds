# Copy to .env and fill in. Never commit real values.
ENV=production

# Where the platform's one database file lives. Mount a volume here to persist.
STORAGE_PATH=./data

# Files the vendored block runtime writes (block file backend, audit store).
# Left unset, the platform pins it under STORAGE_PATH/blocks so no second
# storage root appears beside the mounted disk.
# DATA_DIR=/app/data/blocks

# Postgres. Set DATABASE_URL and the platform runs on it; leave it unset and
# the platform runs on $STORAGE_PATH/platform.db. app/db.py is the one place
# that decides, so a set URL is never silently ignored.
# DATABASE_URL=postgres://user:password@host:5432/fleetops

# Money and tax. The brief names no country, currency or rate, so every one of
# these has NO default: amounts stay bare numbers until you set them, and
# app/settings.py refuses to label money without CURRENCY.
# CURRENCY=USD
# TAX_VAT_RATE=0.20
# TAX_SALES_TAX_RATE=0.0825
# TAX_WITHHOLDING_RATE=0.0

# Email relay — the platform's one live connector. Without SMTP_HOST the
# platform still renders every notice into
# $STORAGE_PATH/notifications/outbox.jsonl and claims nothing as sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=backoffice@example.com
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Deploy identity for /health and scripts/rollback.sh (optional).
# APP_REVISION=rev-n
# APP_MARK=baseline
# SENTRY_DSN=

# Backups. Defaults to $STORAGE_PATH/backups; point it at another volume if
# disk loss (not just logical loss) is in scope.
# BACKUP_DIR=/mnt/backup

# Per-client request ceiling on /v1 (default 600/minute).
# RATE_LIMIT_PER_MINUTE=600

# P1: offline strict. Local/scripted OCR only. No LLM provider. No Ollama.
# No store URL. No store key. Vendored blocks, in-process dispatch.

# Capability routes require this bearer token (HTTP 401 without it).
PLATFORM_TOKEN=dev-local-token

# Additional tenants: "token:tenant_id,token:tenant_id". Each token sees only
# its own tenant's rows.
# TENANT_TOKENS=

# Staff sessions. A caller that authenticates with a token is issued an opaque
# session cookie (fleetops_session) bound to that token's tenant, so the
# console authenticates once instead of re-sending the token on every call.
# SESSION_TTL_SECONDS=28800
# Serve over TLS? Set this so the session cookie is TLS-only.
# SESSION_COOKIE_SECURE=1
