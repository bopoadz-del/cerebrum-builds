# CallOps settings. The application boots with none of these set; each one
# below either has a documented default or makes a path refuse by name.
# Copy to .env and fill in what applies to you. README.md lists which of
# these an operator MUST set before the platform is used for real calls.

# -- the money the brief does not state (no defaults exist for these) -------
# Country and currency for pricing, and every rate: the brief names none of
# them, so nothing is invented here. Set them before quoting a price.
CURRENCY=
VAT_RATE=
BROKER_COMMISSION_RATE=

# -- tenancy and auth -------------------------------------------------------
PLATFORM_TOKEN=dev-local-token
PLATFORM_TENANT=psi
PLATFORM_TOKEN_B=dev-local-token-b
PLATFORM_TENANT_B=other-brokerage
TENANT_TOKENS=
TENANT_NAMES=psi:PSI Properties
# Which brokerage a Twilio number belongs to. A webhook carries no bearer
# token, so the called number is the principal: "+10000000000:psi". An
# unmapped number belongs to PLATFORM_TENANT, never to a name in the form.
TENANT_PHONE_NUMBERS=
# Per-tenant permissions, so a read-only brokerage is refused on a write:
# "psi:read+write+process,other-brokerage:read"
TENANT_PERMISSIONS=

# -- storage ----------------------------------------------------------------
STORAGE_PATH=./data
BACKUP_DIR=
DATABASE_URL=

# -- dialling policy (operator-owned values, with stated defaults) ----------
DAILY_CALL_CAP=250
CONCURRENCY=3
DIAL_INTERVAL_SECONDS=30
MAX_ATTEMPTS=3
RETRY_BACKOFF_MINUTES=45
RETRY_BACKOFF_FACTOR=2.0
CALL_WINDOW_EN=10:00-12:30;17:00-20:00
CALL_WINDOW_AR=11:00-13:30;19:00-22:00
CALL_WINDOW_TZ=UTC
CALL_WINDOW_DAYS=mon,tue,wed,thu,fri,sat
# Leave unset to hold a lead whose number has no country code instead of
# guessing one.
DEFAULT_COUNTRY_CODE=

# -- Twilio voice edge (stubbed until an account and caller number exist) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_NUMBER=
# Where the carrier fetches TwiML and posts status callbacks (settings, never
# request fields).
TWILIO_ANSWER_URL=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_VOICE_EN=Polly.Joanna-Neural
TWILIO_VOICE_AR=Polly.Hala-Neural
# Real dialling needs BOTH credentials and this explicit opt-in.
TWILIO_ALLOW_DIALING=
BROKER_TRANSFER_NUMBER=
CONFERENCE_BRIDGE_TIMEOUT_SECONDS=45

# -- connectors -------------------------------------------------------------
# The one live outbound connector: the broker / sales channel.
SALES_CHANNEL_WEBHOOK=
BROKER_ALERT_WEBHOOK=
# Egress is refused unless the host is public or named here.
EGRESS_ALLOWLIST=
CRM_DESTINATION=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_ALLOW_API=
LOCAL_DRIVE_ROOT=

# -- conversation -----------------------------------------------------------
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=deterministic-planner
LLM_BASE_URL=https://api.openai.com/v1
RETRIEVAL_TOP_K=4
CHUNK_CHARACTERS=900
CHUNK_OVERLAP=120

# -- operations -------------------------------------------------------------
APP_ENV=development
APP_REVISION=rev-n
APP_MARK=baseline
SENTRY_DSN=
AUTH_RATE_WINDOW_S=60
AUTH_RATE_MAX=20
