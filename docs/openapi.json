    "/v1/rag/ground": {
      "get": {
        "description": "Cite-or-refuse posture: per project, which claims retrieval can carry.\n\nFor every ingested project this asks the corpus the three questions that\ncreate liability \u2014 price, payment plan, handover date \u2014 and reports\nwhich of them has a retrieved passage behind it. A claim with no\npassage is the one the live call will withhold, so an operator can see\nthat before a dial rather than after a complaint. Projects with nothing\ningested report as ungrounded, never as answered.",
        "operationId": "ground_posture_v1_rag_ground_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Ground Posture V1 Rag Ground Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
